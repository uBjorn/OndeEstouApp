<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OndeEstouApp.Views.LocalPage"
             Title="LocalPage"
             xmlns:vm="clr-namespace:OndeEstouApp.ViewModels"
             x:DataType="vm:LocalViewModel">
    <ScrollView>
        <VerticalStackLayout>
            <Label Text="📍Minha Localização"/>
            <Button Command="{Binding GetLocationCommand}" Text="Onde estou?"/>
            <Label Text="Rua"/>
            <Entry Text="{Binding CurrentLocation.Thoroughfare}" />
            <Label Text="Nome do local ou número"/>
            <Entry Text="{Binding CurrentLocation.FeatureName}" />
            <Label Text="Pais"/>
            <Entry Text="{Binding CurrentLocation.CountryName}" />
            <Label Text="Cidade"/>
            <Entry Text="{Binding CurrentLocation.Locality}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>